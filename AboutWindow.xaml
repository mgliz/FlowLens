<Window x:Class="FlowLens.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About FlowLens"
        SizeToContent="Height"
        MaxHeight="760"
        Width="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/FlowLens.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Image Source="pack://application:,,,/Assets/FlowLens.png"
                   Width="48"
                   Height="48"
                   Margin="0,0,14,0"
                   Stretch="Uniform"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtitleText"
                           Style="{StaticResource SectionDescription}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource MetricPanel}" Padding="18">
            <StackPanel>
                <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
                <TextBlock x:Name="FeatureText"
                           Style="{StaticResource SectionDescription}"
                           Margin="0,13,0,0"/>
                <TextBlock x:Name="RuntimeText"
                           Style="{StaticResource SectionDescription}"
                           Margin="0,8,0,0"/>

                <Grid Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DataLabelText" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="DataPathText"
                               Grid.Column="1"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LicenseLabelText" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="LicenseText" Grid.Column="1"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource MetricPanel}" Padding="18" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="UpdatesTitleText" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UpdatesSourceText" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="CheckUpdatesButton" Grid.Column="1" HorizontalAlignment="Right" Click="CheckUpdatesButton_Click"/>
                <TextBlock x:Name="UpdateStatusText" Grid.Row="1" TextWrapping="Wrap" Margin="0,10,16,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar x:Name="UpdateProgressBar" Grid.Row="2" Grid.ColumnSpan="2" Height="4" Margin="0,12,0,0" Visibility="Collapsed" Maximum="100"/>
                <Button x:Name="InstallUpdateButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed"
                        Click="InstallUpdateButton_Click">
                    <TextBlock x:Name="InstallUpdateText" Foreground="{DynamicResource AccentForegroundBrush}"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,17,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="AiNoteText"
                       FontSize="11"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"/>
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    IsDefault="True"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
