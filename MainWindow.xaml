<Window x:Class="FlowLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowLens"
        Height="820"
        Width="1320"
        MinHeight="700"
        MinWidth="860"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/FlowLens.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="BrandPanel">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FlowLens" FontSize="29" FontWeight="SemiBold"/>
                    <Border x:Name="BuildBadge" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="4" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BuildBadgeText" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubtitleText"
                           Margin="1,5,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel x:Name="ToolbarPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <ComboBox x:Name="TimeRangeBox"
                          Width="150"
                          Height="38"
                          Margin="0,0,8,0"
                          SelectionChanged="TimeRangeBox_SelectionChanged"/>

                <Border x:Name="SearchHost"
                        Width="260"
                        Height="38"
                        Margin="0,0,8,0"
                        Padding="10,0,4,0"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     MinHeight="0"
                                     Padding="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextChanged="SearchBox_TextChanged"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="SearchPlaceholderText"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Button x:Name="SearchClearButton"
                                Grid.Column="2"
                                Style="{StaticResource ToolbarButton}"
                                Content="&#xE894;"
                                Width="30"
                                Height="30"
                                MinWidth="0"
                                Margin="2,0,0,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Visibility="Collapsed"
                                Click="SearchClearButton_Click"/>
                    </Grid>
                </Border>

                <Button x:Name="SettingsButton"
                        Style="{StaticResource ToolbarButton}"
                        Content="&#xE713;"
                        Margin="0,0,8,0"
                        Click="SettingsButton_Click"/>
                <Button x:Name="AboutButton"
                        Style="{StaticResource ToolbarButton}"
                        Content="&#xE946;"
                        Click="AboutButton_Click"/>
            </StackPanel>
            <StackPanel x:Name="CustomRangePanel" Grid.Row="2" Grid.ColumnSpan="2"
                        Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel.Resources>
                    <Style TargetType="DatePicker">
                        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DatePicker">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="5" Padding="8,0,4,0">
                                        <Grid x:Name="PART_Root">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                            <DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" BorderThickness="0"
                                                               Foreground="{TemplateBinding Foreground}" Padding="0" VerticalContentAlignment="Center">
                                                <DatePickerTextBox.Template>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                                                    </ControlTemplate>
                                                </DatePickerTextBox.Template>
                                            </DatePickerTextBox>
                                            <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource ToolbarButton}"
                                                    Width="28" Height="30" MinWidth="0" MinHeight="0" FontSize="15"
                                                    Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource MutedBrush}"
                                                    Content="&#xE787;" Focusable="False"/>
                                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Resources>
                            <Style TargetType="Button">
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                </StackPanel.Resources>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CustomRangeEditButton" Padding="12,6" Background="{DynamicResource SubtlePanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}" Click="CustomRangeEdit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="CustomRangeAppliedText" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CustomRangeEditText" Margin="16,0,0,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="CustomHistoryHint" Margin="12,0,0,0" FontSize="11"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <Border x:Name="CustomRangeEditor" Visibility="Collapsed" HorizontalAlignment="Left" Width="660"
                        Margin="0,10,0,0" Padding="20,16" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="CustomRangeTitle" FontSize="15" FontWeight="SemiBold"/>
                        <Grid Margin="0,16,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CustomStartLabel" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <DatePicker x:Name="CustomStartPicker" Margin="0,0,8,0" SelectedDateFormat="Short"
                                                DateValidationError="CustomDate_ValidationError" TextBoxBase.TextChanged="CustomDate_TextChanged" CalendarOpened="CustomCalendar_Opened"/>
                                    <ComboBox x:Name="CustomStartHourBox" Grid.Column="1" Height="40"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="CustomEndLabel" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <DatePicker x:Name="CustomEndPicker" Margin="0,0,8,0" SelectedDateFormat="Short"
                                                DateValidationError="CustomDate_ValidationError" TextBoxBase.TextChanged="CustomDate_TextChanged" CalendarOpened="CustomCalendar_Opened"/>
                                    <ComboBox x:Name="CustomEndHourBox" Grid.Column="1" Height="40"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CustomRangeError" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource WarningBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CustomRangeHint" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CustomRangeCancelButton" Click="CustomRangeCancel_Click" Margin="0,0,8,0" Background="Transparent"/>
                                <Button x:Name="CustomRangeApplyButton" Click="CustomRangeApply_Click" Background="{DynamicResource AccentBrush}" BorderThickness="0">
                                    <TextBlock x:Name="CustomRangeApplyText" Foreground="{DynamicResource AccentForegroundBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,7">
                <TextBlock x:Name="NetworkSectionTitleText"
                           Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="NetworkAdapterText"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource MetricPanel}"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="NetworkCurrentLabelText"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="NetworkRateText"
                                   Text="0 B/s"
                                   Margin="0,5,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock x:Name="NetworkReceiveLabelText"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="NetworkReceiveRateText"
                                   Text="0 B/s"
                                   Margin="0,5,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                        <TextBlock x:Name="NetworkSendLabelText"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="NetworkSendRateText"
                                   Text="0 B/s"
                                   Margin="0,5,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentAltBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="14,0,0,0">
                        <TextBlock x:Name="NetworkPeriodLabelText"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="NetworkBytesText"
                                   Text="0 B"
                                   Margin="0,5,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="AttributionSectionTitleText"
                       Style="{StaticResource SectionHeader}"
                       Margin="0,0,0,7"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource MetricPanel}"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="TotalLabelText"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="TotalRateText"
                                   Text="0 B/s"
                                   Margin="0,6,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock x:Name="TotalBytesText"
                                   Text="0 B"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource MetricPanel}"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="Ipv4LabelText"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="Ipv4RateText"
                                   Text="0 B/s"
                                   Margin="0,6,0,0"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock x:Name="Ipv4BytesText"
                                   Text="0 B"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource MetricPanel}"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="Ipv6LabelText"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="Ipv6RateText"
                                   Text="0 B/s"
                                   Margin="0,6,0,0"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentAltBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock x:Name="Ipv6BytesText"
                                   Text="0 B"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource MetricPanel}">
                    <StackPanel>
                        <TextBlock x:Name="ProcessesLabelText"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="ProcessCountText"
                                   Text="0 / 0"
                                   Margin="0,6,0,0"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="7"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="12,8"
                        Background="{DynamicResource SubtlePanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProcessTableTitleText"
                                   Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SortSummaryText"
                                   Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="TrafficGrid"
                          Grid.Row="1"
                          BorderThickness="0"
                          AlternationCount="2"
                          FrozenColumnCount="1"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          Sorting="TrafficGrid_Sorting">
                    <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ProcessColumn"
                                        Binding="{Binding ProcessName}"
                                        SortMemberPath="ProcessName"
                                        ElementStyle="{StaticResource TextCellText}"
                                        Width="190"
                                        MinWidth="140"/>
                    <DataGridTextColumn x:Name="PidColumn"
                                        Header="PID"
                                        Binding="{Binding PidText}"
                                        SortMemberPath="Pid"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="76"/>
                    <DataGridTextColumn x:Name="RateColumn"
                                        Binding="{Binding TotalRateText}"
                                        SortMemberPath="TotalRate"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="106"/>
                    <DataGridTextColumn x:Name="Ipv4RateColumn"
                                        Binding="{Binding Ipv4RateText}"
                                        SortMemberPath="Ipv4Rate"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="164"/>
                    <DataGridTextColumn x:Name="Ipv6RateColumn"
                                        Binding="{Binding Ipv6RateText}"
                                        SortMemberPath="Ipv6Rate"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="164"/>
                    <DataGridTextColumn x:Name="ReceivedColumn"
                                        Binding="{Binding TotalReceivedText}"
                                        SortMemberPath="TotalReceived"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="112"/>
                    <DataGridTextColumn x:Name="SentColumn"
                                        Binding="{Binding TotalSentText}"
                                        SortMemberPath="TotalSent"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="112"/>
                    <DataGridTextColumn x:Name="Ipv4Column"
                                        Binding="{Binding Ipv4TotalText}"
                                        SortMemberPath="Ipv4Total"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="156"/>
                    <DataGridTextColumn x:Name="Ipv6Column"
                                        Binding="{Binding Ipv6TotalText}"
                                        SortMemberPath="Ipv6Total"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="156"/>
                    <DataGridTextColumn x:Name="TcpColumn"
                                        Binding="{Binding TcpTotalText}"
                                        SortMemberPath="TcpTotal"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="156"/>
                    <DataGridTextColumn x:Name="UdpColumn"
                                        Binding="{Binding UdpTotalText}"
                                        SortMemberPath="UdpTotal"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="156"/>
                    <DataGridTextColumn x:Name="FlowsColumn"
                                        Binding="{Binding Connections}"
                                        SortMemberPath="Connections"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        ElementStyle="{StaticResource NumericCellText}"
                                        Width="76"/>
                    <DataGridTextColumn x:Name="PathColumn"
                                        Binding="{Binding Path}"
                                        SortMemberPath="Path"
                                        ElementStyle="{StaticResource TextCellText}"
                                        Width="*"
                                        MinWidth="220"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,11,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusIconText"
                           Text="&#xE73E;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="12"
                           Foreground="{DynamicResource SuccessBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,7,0"/>
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="TrayHintText"
                       Grid.Column="1"
                       Margin="20,0,0,0"
                       Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</Window>
