<Window x:Class="FlowLens.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowLens Settings"
        Height="740"
        Width="680"
        MinHeight="620"
        MinWidth="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/FlowLens.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,17">
            <TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Style="{StaticResource SectionDescription}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,14,0">
                <TextBlock x:Name="GeneralSectionText" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="StartWithWindowsBox"/>
                <CheckBox x:Name="StartMinimizedBox"/>
                <CheckBox x:Name="CloseToTrayBox"/>
                <CheckBox x:Name="AlwaysOnTopBox"/>
                <TextBlock x:Name="StartupNoteText"
                           Style="{StaticResource SectionDescription}"
                           Margin="27,7,0,0"/>

                <Border Height="1" Margin="0,18,0,16" Background="{DynamicResource LineBrush}"/>

                <TextBlock x:Name="CaptureSectionText" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NetworkInterfaceLabel" VerticalAlignment="Center"/>
                    <ComboBox x:Name="NetworkInterfaceBox"
                              Grid.Column="1"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              AutomationProperties.LabeledBy="{Binding ElementName=NetworkInterfaceLabel}"/>
                </Grid>
                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RefreshIntervalLabel" VerticalAlignment="Center"/>
                    <ComboBox x:Name="RefreshIntervalBox"
                              Grid.Column="1"
                              AutomationProperties.LabeledBy="{Binding ElementName=RefreshIntervalLabel}"/>
                </Grid>
                <CheckBox x:Name="ExcludeLocalTrafficBox"/>

                <Border Height="1" Margin="0,18,0,16" Background="{DynamicResource LineBrush}"/>

                <TextBlock x:Name="AppearanceSectionText" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ThemeBox"
                              Grid.Column="1"
                              SelectionChanged="ThemeBox_SelectionChanged"
                              AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}">
                        <ComboBoxItem x:Name="SystemThemeItem" Tag="System"/>
                        <ComboBoxItem x:Name="DarkThemeItem" Tag="Dark"/>
                        <ComboBoxItem x:Name="LightThemeItem" Tag="Light"/>
                    </ComboBox>
                </Grid>
                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LanguageBox"
                              Grid.Column="1"
                              AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}">
                        <ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="中文" Tag="zh-CN"/>
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="UseBitsPerSecondBox"/>
                <CheckBox x:Name="HideIdleRowsBox"/>
                <Grid Margin="27,9,0,0"
                      IsEnabled="{Binding IsChecked, ElementName=HideIdleRowsBox}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MinimumBytesLabel" VerticalAlignment="Center"/>
                    <TextBox x:Name="MinimumBytesBox"
                             Grid.Column="1"
                             AutomationProperties.LabeledBy="{Binding ElementName=MinimumBytesLabel}"/>
                </Grid>

                <Border Height="1" Margin="0,18,0,16" Background="{DynamicResource LineBrush}"/>

                <TextBlock x:Name="VisibleColumnsLabel" Style="{StaticResource SectionHeader}"/>
                <UniformGrid Columns="2" Margin="0,3,0,0">
                    <CheckBox x:Name="ShowPidColumnBox"/>
                    <CheckBox x:Name="ShowRateColumnsBox"/>
                    <CheckBox x:Name="ShowTotalColumnsBox"/>
                    <CheckBox x:Name="ShowIpSplitColumnsBox"/>
                    <CheckBox x:Name="ShowProtocolColumnsBox"/>
                    <CheckBox x:Name="ShowFlowsColumnBox"/>
                    <CheckBox x:Name="ShowPathColumnBox"/>
                </UniformGrid>

                <Border Height="1" Margin="0,18,0,16" Background="{DynamicResource LineBrush}"/>

                <TextBlock x:Name="DataSectionText" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="PersistStatsBox"/>
                <Button x:Name="ResetStatsButton"
                        Style="{StaticResource DangerButton}"
                        Margin="0,12,0,2"
                        HorizontalAlignment="Left"
                        Click="ResetStatsButton_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,17,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText"
                       Foreground="{DynamicResource DangerBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" IsDefault="True" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
